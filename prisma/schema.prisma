generator client {
  provider            = "prisma-client"
  output              = "../apps/server/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum EpisodeStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum ShotStatus {
  DRAFT
  GENERATING
  PENDING_REVIEW
  APPROVED
}

enum AssetType {
  IMAGE
  VIDEO
  AUDIO
  SUBTITLE
}

enum GenerationType {
  IMAGE
  VIDEO
  AUDIO
}

enum GenerationStatus {
  QUEUED
  SUBMITTING
  SUBMISSION_UNKNOWN
  PROCESSING
  FAILED
  SUCCEEDED
}

enum ReviewResult {
  PASSED
  FAILED
}

enum ExportStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}

model Project {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  settings   Json        @default("{}")
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  episodes   Episode[]
  characters Character[]
}

model Episode {
  id              String           @id @default(uuid()) @db.Uuid
  projectId       String           @db.Uuid
  title           String
  status          EpisodeStatus    @default(DRAFT)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scriptRevisions ScriptRevision[]
  scenes          Scene[]
  exports         ExportRecord[]

  @@index([projectId])
}

model ScriptRevision {
  id        String   @id @default(uuid()) @db.Uuid
  episodeId String   @db.Uuid
  content   Json
  version   Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, version])
}

model Character {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String   @db.Uuid
  name        String
  description String   @default("")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shots       Shot[]

  @@index([projectId])
}

model Scene {
  id          String   @id @default(uuid()) @db.Uuid
  episodeId   String   @db.Uuid
  location    String
  description String   @default("")
  order       Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  shots       Shot[]

  @@unique([episodeId, order])
}

model Shot {
  id              String           @id @default(uuid()) @db.Uuid
  sceneId         String           @db.Uuid
  order           Int
  duration        Decimal          @db.Decimal(8, 3)
  prompt          String           @default("")
  status          ShotStatus       @default(DRAFT)
  selectedAssetId String?          @db.Uuid
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  scene           Scene            @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  characters      Character[]
  assets          ShotAsset[]      @relation("ShotAssets")
  selectedAsset   ShotAsset?       @relation("SelectedShotAsset", fields: [id, selectedAssetId], references: [shotId, assetId], onDelete: NoAction, onUpdate: NoAction)
  generationTasks GenerationTask[]

  @@unique([sceneId, order])
}

// The selected asset must already be linked to the same shot; assets can be reused.
model ShotAsset {
  shotId     String @db.Uuid
  assetId    String @db.Uuid
  shot       Shot   @relation("ShotAssets", fields: [shotId], references: [id], onDelete: Cascade)
  asset      Asset  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  selectedBy Shot[] @relation("SelectedShotAsset")

  @@id([shotId, assetId])
  @@index([assetId])
}

model Asset {
  id               String          @id @default(uuid()) @db.Uuid
  type             AssetType
  storageKey       String          @unique
  metadata         Json            @default("{}")
  generationTaskId String?         @db.Uuid
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  generationTask   GenerationTask? @relation(fields: [generationTaskId], references: [id], onDelete: SetNull)
  shots            ShotAsset[]
  reviews          QualityReview[]

  @@index([generationTaskId])
}

model GenerationTask {
  id             String           @id @default(uuid()) @db.Uuid
  shotId         String           @db.Uuid
  type           GenerationType
  provider       String
  model          String
  status         GenerationStatus @default(QUEUED)
  request        Json
  providerTaskId String?
  idempotencyKey String           @unique
  error          String?
  cost           Decimal?         @db.Decimal(12, 6)
  currency       String           @default("USD") @db.VarChar(3)
  startedAt      DateTime?        @db.Timestamptz(3)
  finishedAt     DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  shot           Shot             @relation(fields: [shotId], references: [id], onDelete: Cascade)
  outputs        Asset[]

  @@unique([provider, providerTaskId])
  @@index([shotId])
  @@index([status, createdAt])
}

model QualityReview {
  id        String       @id @default(uuid()) @db.Uuid
  assetId   String       @db.Uuid
  result    ReviewResult
  issues    Json         @default("[]")
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  asset     Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

model ExportRecord {
  id         String       @id @default(uuid()) @db.Uuid
  episodeId  String       @db.Uuid
  settings   Json
  status     ExportStatus @default(QUEUED)
  storageKey String?
  error      String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)
  episode    Episode      @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId])
}
