{
  "name": "noema",
  "version": "0.0.0",
  "private": true,
  "description": "面向个人创作者的 AI 短剧创作平台",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev:desktop": "corepack pnpm --filter @noema/desktop dev",
    "dev:server": "corepack pnpm --filter @noema/server dev",
    "infra:up": "docker compose -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "infra:check": "docker compose -f infra/compose.yaml exec -T postgres pg_isready -U noema -d noema && docker compose -f infra/compose.yaml exec -T redis redis-cli ping",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "corepack pnpm --filter @noema/server db:check",
    "db:test": "corepack pnpm --filter @noema/server db:test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test",
    "build": "corepack pnpm -r build",
    "check": "corepack pnpm lint && corepack pnpm format:check && corepack pnpm typecheck"
  },
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "typescript-eslint": "8.72.1"
  }
}
