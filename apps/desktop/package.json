{
  "name": "@noema/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Noema 个人短剧创作工具桌面端",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "corepack pnpm --filter @noema/shared build && electron-vite dev",
    "typecheck": "corepack pnpm --filter @noema/shared build && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "corepack pnpm --filter @noema/shared build && electron-vite build",
    "smoke": "node scripts/smoke.mjs",
    "smoke:dev": "node scripts/smoke-dev.mjs",
    "smoke:projects": "node --env-file-if-exists=../../.env --test scripts/smoke-projects.mjs"
  },
  "dependencies": {
    "@noema/shared": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.2",
    "lucide-react": "1.67.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "45.2.1",
    "electron-vite": "6.0.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
