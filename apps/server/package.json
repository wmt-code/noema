{
  "name": "@noema/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=src --watch-path=tsconfig.json scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
