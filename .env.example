# Local development only. Keep ports and credentials in sync with infra/compose.yaml.
DATABASE_URL=postgresql://noema:noema_local@127.0.0.1:15432/noema?schema=public&connect_timeout=5
REDIS_URL=redis://127.0.0.1:16379

# Optional server encryption-key directory; defaults to .data at the repository root.
# Model API keys are configured in desktop Settings, not in this file.
# NOEMA_DATA_DIR=/secure/persistent/noema
